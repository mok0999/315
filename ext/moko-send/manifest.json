{
  "manifest_version": 3,
  "name": "발췌기로 보내기",
  "version": "1.0",
  "description": "드래그한 글을 채팅 발췌기 작성창으로 바로 보내요.",
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"},
  "background": {"service_worker": "background.js"},
  "host_permissions": ["https://mok0999.github.io/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "exclude_matches": ["https://mok0999.github.io/315/chat.html*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
